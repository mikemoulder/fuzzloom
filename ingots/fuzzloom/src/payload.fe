//! Result payloads. A harness test ends by reverting with exactly one of
//! these ABI-encoded custom errors; the CLI reads it from `fe test` output.
//! The byte encoding is identical on the sonatina and native backends.
//!
//! Frozen contract with packages/cli: field order and types do not change
//! without a matching decoder change. Inputs are always three words; words
//! past `arity` are zero.

/// The property failed. `original` is the first failing input and `shrunk`
/// the smallest failing input found from it.
#[error]
pub struct Counterexample {
    pub seed: u64,
    pub iteration: u64,
    pub arity: u64,
    pub original0: u256,
    pub original1: u256,
    pub original2: u256,
    pub shrunk0: u256,
    pub shrunk1: u256,
    pub shrunk2: u256,
    pub shrink_attempts: u64,
    pub shrink_complete: bool,
}

/// The property held for every generated input. The statistics say what
/// was exercised: argument draws taken from the edge table, inputs whose
/// arguments were correlated, and a bitmask of argument extremes reached
/// (bit 2i: argument i hit its lower bound; bit 2i + 1: its upper bound).
#[error]
pub struct Passed {
    pub seed: u64,
    pub runs: u64,
    pub arity: u64,
    pub edge_args: u64,
    pub correlated: u64,
    pub extremes: u64,
}

/// Result of replaying one saved input against a property.
#[error]
pub struct Replayed {
    pub arity: u64,
    pub input0: u256,
    pub input1: u256,
    pub input2: u256,
    pub failed: bool,
}

/// The input a campaign draws at `iteration`, without evaluating anything.
/// Used to recover the input when a property aborts instead of returning
/// false.
#[error]
pub struct Generated {
    pub seed: u64,
    pub iteration: u64,
    pub arity: u64,
    pub input0: u256,
    pub input1: u256,
    pub input2: u256,
}

/// A fold of a function's outputs over the campaign input stream, for
/// comparing backends.
#[error]
pub struct Digest { pub seed: u64, pub runs: u64, pub arity: u64, pub acc: u256 }

/// One differential target's output for one input, so the CLI can show
/// exactly how two backends disagree on the first diverging input.
#[error]
pub struct Evaluated {
    pub arity: u64,
    pub input0: u256,
    pub input1: u256,
    pub input2: u256,
    pub output: u256,
}
