//! Differential digests.
//!
//! A digest folds a function's outputs over the campaign input stream (the
//! same `draw` stream properties use). The same harness built for sonatina
//! and for native must produce the same digest. Digests are prefix-
//! consistent: the first k folds are identical for any run count >= k. The
//! CLI uses keyed checkpoints to search for the first differing output, then
//! checks the recovered input on both backends. Checkpoints make
//! that search cheap: one pass emits the prefix digests at many run counts,
//! so a search round is one test per backend.
//!
//! Keyed checkpoints use a polynomial over GF(2^127 - 1). Matching
//! checkpoints may collide. The unkeyed API retains its original checksum.

use ingot::rng::Rng
use ingot::word::Word
use ingot::input::{Bounds, Input}
use ingot::draw::{draw, generated_at}
use ingot::payload::{Checkpoints, Digest, Evaluated, Generated}
use std::abi::DynArray
use core::MemVec
use std::evm::revert_error

const FOLD_PRIME: u256 = 0x100000001B3
const FOLD_OFFSET: u256 = 0xCBF29CE484222325
const FIELD_PRIME: u256 = (1 << 127) - 1
const LIMB_MASK: u256 = (1 << 126) - 1

/// A function under differential test: one to three `Word` arguments, one
/// `Word` result.
pub trait Target {
    uses E
    fn arity() -> u64
    fn full_bounds() -> Bounds
    fn eval(self, _ x: Input) -> u256 uses E
}

pub struct Fn1<A, U, F> { pub f: F }

pub struct Fn2<A, B, U, F> { pub f: F }

pub struct Fn3<A, B, C, U, F> { pub f: F }

impl<A: Word, U: Word, F: Fn(A) -> U> Target for Fn1<A, U, F> {
    uses E = F::E

    fn arity() -> u64 {
        1
    }

    fn full_bounds() -> Bounds {
        Bounds::full(A::max_word(), 0, 0)
    }

    fn eval(self, _ x: Input) -> u256 uses E {
        (self.f)(A::from_word(x.w0)).to_word()
    }
}

impl<A: Word, B: Word, U: Word, F: Fn(A, B) -> U> Target for Fn2<A, B, U, F> {
    uses E = F::E

    fn arity() -> u64 {
        2
    }

    fn full_bounds() -> Bounds {
        Bounds::full(A::max_word(), B::max_word(), 0)
    }

    fn eval(self, _ x: Input) -> u256 uses E {
        (self.f)(A::from_word(x.w0), B::from_word(x.w1)).to_word()
    }
}

impl<A: Word, B: Word, C: Word, U: Word, F: Fn(A, B, C) -> U> Target for Fn3<A, B, C, U, F> {
    uses E = F::E

    fn arity() -> u64 {
        3
    }

    fn full_bounds() -> Bounds {
        Bounds::full(A::max_word(), B::max_word(), C::max_word())
    }

    fn eval(self, _ x: Input) -> u256 uses E {
        (self.f)(A::from_word(x.w0), B::from_word(x.w1), C::from_word(x.w2)).to_word()
    }
}

pub fn target1<A: Word, U: Word, F: Fn(A) -> U>(_ f: own F) -> Fn1<A, U, F> {
    Fn1 { f }
}

pub fn target2<A: Word, B: Word, U: Word, F: Fn(A, B) -> U>(_ f: own F) -> Fn2<A, B, U, F> {
    Fn2 { f }
}

pub fn target3<A: Word, B: Word, C: Word, U: Word, F: Fn(A, B, C) -> U>(_ f: own F) -> Fn3<
    A,
    B,
    C,
    U,
    F,
> {
    Fn3 { f }
}

/// Mixes one output word into the accumulator. Order-sensitive.
pub fn fold(_ acc: u256, _ out: u256) -> u256 {
    (acc ^ out).wrapping_mul(FOLD_PRIME).wrapping_add(FOLD_OFFSET)
}

/// One Horner step. For canonical field elements the intermediate fits u256.
/// Since 2^127 == 1 in the field, one fold and one subtraction reduce it.
fn field_step(_ acc: u256, _ limb: u256, _ key: u256) -> u256 {
    let wide = acc.wrapping_mul(key).wrapping_add(limb)
    let reduced = (wide & FIELD_PRIME).wrapping_add(wide >> 127)
    if reduced >= FIELD_PRIME {
        reduced.wrapping_sub(FIELD_PRIME)
    } else {
        reduced
    }
}

/// Fixed-width base-2^126 digits encode the entire word injectively in the
/// field, including leading zeros. Each word contributes three coefficients.
fn keyed_fold(_ acc: u256, _ out: u256, _ key: u256) -> u256 {
    let high = field_step(acc, out >> 252, key)
    let middle = field_step(high, (out >> 126) & LIMB_MASK, key)
    field_step(middle, out & LIMB_MASK, key)
}

#[test]
fn keyed_fold_matches_integer_modulo_reference() {
    // Reference computed with arbitrary-precision multiply and remainder.
    // The words exercise limb boundaries and a product near the field limit.
    let key = FIELD_PRIME - 2
    let a = keyed_fold(0, !0, key)
    assert!(a == 0x4000000000000000000000000000003c)
    let b = keyed_fold(a, FIELD_PRIME, key)
    assert!(b == 0x3ffffffffffffffffffffffffffffe19)
    let c = keyed_fold(b, 1 << 252, key)
    assert!(c == 0xf38)
    assert!(
        keyed_fold(c, 17, key) == 0x7fffffffffffffffffffffffffff8650,
    )
}

#[test]
fn legacy_checksum_reconverges_on_two_words() {
    let left = fold(FOLD_OFFSET, 0)
    let right = fold(FOLD_OFFSET, 1)
    let join = left ^ right
    assert!(left != right)
    assert!(fold(left, 0) == fold(right, join))
    assert!(
        keyed_fold(keyed_fold(0, 0, 17), 0, 17) != keyed_fold(keyed_fold(0, 1, 17), join, 17),
    )
}

#[test]
fn keyed_fold_can_collide_even_on_the_first_word() {
    // At key 1 the coefficient order is lost. A fixed key must never be
    // treated as an unconditional guarantee that the predicate is monotone.
    assert!(keyed_fold(0, 1, 1) == keyed_fold(0, 1 << 126, 1))
}

/// Folds `t` over the first `runs` inputs drawn within `bounds`.
pub fn digest_within<T: Target>(_ t: T, bounds: Bounds, seed: u64, runs: u64) -> u256
uses T::E
{
    let arity = T::arity()
    var rng = Rng::new(seed)
    var acc: u256 = FOLD_OFFSET
    var i: u64 = 0
    while i < runs {
        let x = draw(bounds, arity, mut rng)
        acc = fold(acc, t.eval(x))
        i += 1
    }
    acc
}

/// Folds `t` over the first `runs` inputs of the default campaign.
pub fn digest_of<T: Target>(_ t: T, seed: u64, runs: u64) -> u256
uses T::E
{
    digest_within(t, bounds: T::full_bounds(), seed, runs)
}

/// Harness entry point: end the test with the digest of `t`.
pub fn digest<T: Target>(_ t: T, seed: u64, runs: u64) -> ! uses T::E {
    let acc = digest_of(t, seed, runs)
    revert_error(Digest { seed, runs, arity: T::arity(), acc })
}

/// Most checkpoints one payload carries (8 KiB of digests).
pub const MAX_CHECKPOINTS: u64 = 256

/// Prefix digests of `t` at run counts `first + j * step` for j in
/// 0..count, from a single pass over the first `first + (count - 1) * step`
/// inputs.
///
/// Guarantee: element j equals `digest_within(t, bounds, seed, first + j *
/// step)` exactly, because a digest's first k folds do not depend on the run
/// count. Limit: the pass costs as much as the largest checkpoint's digest;
/// `step` may be 0 (repeated checkpoints) and `count` 0 (empty).
pub fn checkpoints_within<T: Target>(
    _ t: T,
    bounds: Bounds,
    seed: u64,
    first: u64,
    step: u64,
    count: u64,
) -> MemVec<u256>
uses T::E
{
    collect_checkpoints(t, bounds, seed, first, step, count, 0)
}

fn collect_checkpoints<T: Target>(
    _ t: T,
    _ bounds: Bounds,
    _ seed: u64,
    _ first: u64,
    _ step: u64,
    _ count: u64,
    _ key: u256,
) -> MemVec<u256>
uses T::E
{
    let arity = T::arity()
    var rng = Rng::new(seed)
    // Zero selects the legacy checksum. A keyed digest starts from field zero.
    var acc: u256 = if key == 0 { FOLD_OFFSET } else { 0 }
    var out: MemVec<u256> = MemVec::new()
    var done: u64 = 0
    var j: u64 = 0
    while j < count {
        let at = first + j * step
        while done < at {
            let x = draw(bounds, arity, mut rng)
            let word = t.eval(x)
            acc = if key == 0 {
                fold(acc, word)
            } else {
                keyed_fold(acc, word, key)
            }
            done += 1
        }
        out.push(acc)
        j += 1
    }
    out
}

/// `checkpoints_within` over the default campaign bounds.
pub fn checkpoints_of<T: Target>(_ t: T, seed: u64, first: u64, step: u64, count: u64) -> MemVec<
    u256,
>
uses T::E
{
    checkpoints_within(t, bounds: T::full_bounds(), seed, first, step, count)
}

/// Harness entry point: end the test with the checkpoints of `t`. Panics
/// (assertion) when `count` exceeds MAX_CHECKPOINTS, so an oversized request
/// fails loudly instead of being truncated; the CLI never sends one.
pub fn digest_checkpoints<T: Target>(_ t: T, seed: u64, first: u64, step: u64, count: u64) -> !
uses T::E
{
    digest_checkpoints_within(t, bounds: T::full_bounds(), seed, first, step, count)
}

/// Harness entry point: `digest_checkpoints` over inputs drawn within `bounds`.
pub fn digest_checkpoints_within<T: Target>(
    _ t: T,
    bounds: Bounds,
    seed: u64,
    first: u64,
    step: u64,
    count: u64,
) -> !
uses T::E
{
    assert!(count <= MAX_CHECKPOINTS)
    let accs = checkpoints_within(t, bounds, seed, first, step, count)
    revert_error(
        Checkpoints { seed, first, step, arity: T::arity(), accs: DynArray::from_mem_vec(accs) },
    )
}

/// Prefix fingerprints under a key in 1..FIELD_PRIME. If two length-k output
/// streams differ, their difference is a nonzero polynomial of degree at most
/// 3*k-1. An independently uniform nonzero key hits a root with probability
/// at most (3*k-1)/(FIELD_PRIME-1). A caller-supplied fixed key has no such
/// probability guarantee. Use the same key for both backends and all rounds.
pub fn keyed_checkpoints_within<T: Target>(
    _ t: T,
    bounds: Bounds,
    seed: u64,
    first: u64,
    step: u64,
    count: u64,
    key: u256,
) -> !
uses T::E
{
    assert!(count <= MAX_CHECKPOINTS && key > 0 && key < FIELD_PRIME)
    let accs = collect_checkpoints(t, bounds, seed, first, step, count, key)
    revert_error(
        Checkpoints { seed, first, step, arity: T::arity(), accs: DynArray::from_mem_vec(accs) },
    )
}

/// Harness entry point: the input the digest of `t` draws at `iteration`.
pub fn target_input_at<T: Target>(_ t: T, seed: u64, iteration: u64) -> ! {
    target_input_at_within(t, bounds: T::full_bounds(), seed, iteration)
}

/// The full bounds of `t`'s argument types, as a value (an associated
/// function call on a generic type cannot appear in a harness expression).
pub fn target_bounds_of<T: Target>(_ t: T) -> Bounds {
    T::full_bounds()
}

/// Harness entry point: the input a digest within `bounds` draws at `iteration`.
pub fn target_input_at_within<T: Target>(_ t: T, bounds: Bounds, seed: u64, iteration: u64) -> ! {
    let arity = T::arity()
    let x = generated_at(bounds, arity, seed, iteration)
    revert_error(
        Generated { seed, iteration, arity, input0: x.w0, input1: x.w1, input2: x.w2 },
    )
}

/// Harness entry point: the output word of `t` for one input.
pub fn evaluate<T: Target>(_ t: T, input: Input) -> ! uses T::E {
    let output = t.eval(input)
    revert_error(
        Evaluated {
            arity: T::arity(),
            input0: input.w0,
            input1: input.w1,
            input2: input.w2,
            output,
        },
    )
}

/// Pure counterpart of `target_input_at`, for tests.
pub fn target_generated_at<T: Target>(_ t: T, seed: u64, iteration: u64) -> Input {
    generated_at(T::full_bounds(), arity: T::arity(), seed, iteration)
}

#[test]
fn digest_is_deterministic() {
    let a = digest_of(target1(|x: u64| x.wrapping_mul(3)), seed: 9, runs: 5000)
    let b = digest_of(target1(|x: u64| x.wrapping_mul(3)), seed: 9, runs: 5000)
    assert!(a == b)
}

#[test]
fn digest_detects_a_single_differing_output() {
    let a = digest_of(target1(|x: u64| x), seed: 4, runs: 3000)
    let b = digest_of(
        target1(|x: u64| if x == 0xFFFFFFFFFFFFFFFF { 0 } else { x }),
        seed: 4,
        runs: 3000,
    )
    assert!(a != b)
}

#[test]
fn digest_depends_on_seed_and_runs() {
    let a = digest_of(target1(|x: u32| x), seed: 1, runs: 100)
    let b = digest_of(target1(|x: u32| x), seed: 2, runs: 100)
    let c = digest_of(target1(|x: u32| x), seed: 1, runs: 101)
    assert!(a != b && a != c)
}

#[test]
fn zero_runs_is_the_offset() {
    assert!(
        digest_of(target1(|x: u8| x), seed: 1, runs: 0) == FOLD_OFFSET,
    )
}

#[test]
fn multi_argument_targets_digest() {
    let a = digest_of(target2(|x: u64, y: u64| x ^ y), seed: 3, runs: 2000)
    let b = digest_of(target2(|x: u64, y: u64| x | y), seed: 3, runs: 2000)
    let c = digest_of(
        target3(|x: i32, y: i32, z: bool| if z { x } else { y }),
        seed: 3,
        runs: 2000,
    )
    assert!(a != b && c != a)
}

fn kav_target(_ x: u64) -> u64 {
    x.wrapping_mul(0x9E3779B97F4A7C15) ^ (x >> 7)
}

#[test]
fn known_answer_digest_matches_on_every_backend() {
    // Recorded identically from sonatina and native. Every backend's test run
    // checks itself against this one constant, so a backend that computes
    // the fold, the generator or the PRNG differently fails here.
    // Re-recorded (on both backends) when range sampling moved from modulo
    // reduction to rejection sampling, which intentionally changed the stream.
    let d = digest_of(target1(kav_target), seed: 12345, runs: 10000)
    assert!(
        d == 0x4fe7ee18bc39b26b26bc0d3110bc7fdc16b3e184337095313705a1c15fde6adf,
    )
}

#[test]
fn digest_is_the_fold_of_the_generated_inputs() {
    // target_generated_at reproduces exactly the inputs the digest folds,
    // which is what lets the CLI evaluate the first diverging input.
    let t = target2(|x: u32, y: u32| x ^ y)
    var acc: u256 = FOLD_OFFSET
    var i: u64 = 0
    while i < 50 {
        acc = fold(acc, t.eval(target_generated_at(t, seed: 3, iteration: i)))
        i += 1
    }
    assert!(acc == digest_of(t, seed: 3, runs: 50))
}

/// Checkpoints as the payload carries them, for tests.
fn checkpoints_payload<T: Target>(_ t: T, seed: u64, first: u64, step: u64, count: u64) -> DynArray<
    u256,
>
uses T::E
{
    DynArray::from_mem_vec(checkpoints_of(t, seed, first, step, count))
}

fn at(_ a: DynArray<u256>, _ j: u64) -> u256 {
    a.get(j.downcast_truncate())
}

#[test]
fn every_checkpoint_equals_the_digest_at_its_run_count() {
    // The stated guarantee, element by element, including a first checkpoint
    // at zero runs (the offset) and a multi-argument target.
    let t = target2(|x: u64, y: u64| x.wrapping_mul(y) ^ (x >> 3))
    let cps = checkpoints_payload(t, seed: 11, first: 0, step: 37, count: 30)
    assert!(cps.len() == 30)
    var j: u64 = 0
    while j < 30 {
        assert!(at(cps, j) == digest_of(t, seed: 11, runs: j * 37))
        j += 1
    }
}

#[test]
fn checkpoints_locate_the_first_differing_output() {
    // A target that differs from the identity only on inputs above 2^63.
    // Checkpoint digests agree before the first such input and differ at and
    // after it, which is the monotonicity the CLI search relies on.
    let a = target1(|x: u64| x)
    let b = target1(|x: u64| if x > 0x8000000000000000 { x - 1 } else { x })
    let ca = checkpoints_payload(a, seed: 5, first: 1, step: 1, count: 64)
    let cb = checkpoints_payload(b, seed: 5, first: 1, step: 1, count: 64)
    var first_bad: u64 = 64
    var j: u64 = 0
    while j < 64 {
        let differs = at(ca, j) != at(cb, j)
        if first_bad == 64 && differs {
            first_bad = j
        }
        assert!(differs == (first_bad <= j))
        j += 1
    }
    assert!(first_bad < 64)
    // Checkpoint j covers inputs 0..=j, so the first differing input is j.
    let x = target_generated_at(a, seed: 5, iteration: first_bad)
    assert!(x.w0 > 0x8000000000000000)
}

#[test]
fn zero_step_and_zero_count_are_well_defined() {
    let t = target1(|x: u8| x)
    let rep = checkpoints_payload(t, seed: 2, first: 9, step: 0, count: 3)
    assert!(rep.len() == 3)
    assert!(
        at(rep, 0) == at(rep, 2) && at(rep, 0) == digest_of(t, seed: 2, runs: 9),
    )
    assert!(
        checkpoints_payload(t, seed: 2, first: 9, step: 4, count: 0).len() == 0,
    )
}

#[test]
fn target_bounds_of_is_the_full_type_range() {
    let b = target_bounds_of(target2(|x: u8, y: i16| (x as i16) + y))
    assert!(b.lo.same(Input::zero()))
    assert!(b.hi.w0 == 0xff && b.hi.w1 == 0xffff && b.hi.w2 == 0)
}
