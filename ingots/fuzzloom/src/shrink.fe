//! Failure shrinking for word inputs.
//!
//! Two phases, neither of which needs the failure to be monotone:
//!
//! 1. Small-value sweep: try `lo, lo + 1, ..., lo + SWEEP - 1` in order and
//!    take the first that fails. Small counterexamples are the most readable,
//!    and this finds them exactly.
//! 2. Greedy descent: from the best failing word, try stepping down by the
//!    floor `lo` itself, then by exact powers of two (2^k for k from the top
//!    bit of the distance down to 0). The first candidate that still fails
//!    becomes the new best and the scan restarts.
//!
//! Guarantee when `complete` is true: the result fails, `lo` passes (unless
//! the result is `lo`), and no `result - 2^k >= lo` fails. That is a local
//! minimum, not necessarily the global one. Exact powers of two matter: steps
//! of `best / 2^j` can all share a parity, which under zigzag encoding means
//! all share a sign, and the descent then stalls on the first input.

use ingot::word::Word
use ingot::bias::bit_len

/// Width of the small-value sweep in phase 1.
pub const SWEEP: u256 = 256

/// Result of a shrink.
pub struct Shrunk {
    /// Smallest failing word found.
    pub value: u256,
    /// Number of times the failure predicate was evaluated.
    pub attempts: u64,
    /// True if shrinking reached a local minimum, false if the budget ran out.
    pub complete: bool,
}

impl Copy for Shrunk {}

/// Shrinks the failing word `failing` toward `lo`. A candidate word `c`
/// still fails when `holds(T::from_word(c))` is false.
pub fn shrink<T: Word, P: Fn(T) -> bool>(_ holds: P, failing: u256, lo: u256, budget: u64) -> Shrunk
uses P::E
{
    var best = failing
    var attempts: u64 = 0

    // Phase 1: small-value sweep.
    var c = lo
    while c < best && c - lo < SWEEP {
        if attempts >= budget {
            return Shrunk { value: best, attempts, complete: false }
        }
        attempts += 1
        if !holds(T::from_word(c)) {
            return Shrunk { value: c, attempts, complete: true }
        }
        c += 1
    }

    // Phase 2: greedy descent by exact powers of two. Each round first
    // tries `lo` itself, then best - 2^k for k from the top bit of the
    // distance down to 0, and restarts from the first candidate that fails.
    var progressed = true
    while progressed {
        progressed = false
        if best == lo {
            return Shrunk { value: best, attempts, complete: true }
        }
        if attempts >= budget {
            return Shrunk { value: best, attempts, complete: false }
        }
        attempts += 1
        if !holds(T::from_word(lo)) {
            return Shrunk { value: lo, attempts, complete: true }
        }
        var k = bit_len(best - lo)
        while k > 0 {
            k -= 1
            let step: u256 = 1 << k
            if step <= best - lo {
                if attempts >= budget {
                    return Shrunk { value: best, attempts, complete: false }
                }
                attempts += 1
                let candidate = best - step
                if !holds(T::from_word(candidate)) {
                    best = candidate
                    progressed = true
                    k = 0
                }
            }
        }
    }
    Shrunk { value: best, attempts, complete: true }
}

#[test]
fn shrinks_threshold_failure_to_the_threshold() {
    let r = shrink(
        |w: u256| !(w >= 1000),
        failing: 98765,
        lo: 0,
        budget: 10000,
    )
    assert!(r.value == 1000)
    assert!(r.complete)
}

#[test]
fn shrinks_to_floor_when_everything_fails() {
    let r = shrink(
        |w: u256| !(true),
        failing: u256::max(),
        lo: 5,
        budget: 10000,
    )
    assert!(r.value == 5)
}

#[test]
fn handles_non_monotone_failures() {
    // Fails only on multiples of 7 above 100: the answer is 105, which a
    // plain binary search over a monotone predicate can miss.
    let r = shrink(
        |w: u256| !(w > 100 && w % 7 == 0),
        failing: 7000,
        lo: 0,
        budget: 10000,
    )
    assert!(r.value == 105)
}

#[test]
fn shrinks_top_of_u64_window() {
    let r = shrink(
        |w: u256| !(w > 0xFFFFFFFFFFFFFF00 && w <= 0xFFFFFFFFFFFFFFFF),
        failing: 0xFFFFFFFFFFFFFFF3,
        lo: 0,
        budget: 10000,
    )
    assert!(r.value == 0xFFFFFFFFFFFFFF01)
}

#[test]
fn respects_budget() {
    let r = shrink(
        |w: u256| !(w >= 1000000),
        failing: u256::max(),
        lo: 0,
        budget: 3,
    )
    assert!(!r.complete)
    assert!(r.attempts == 3)
    assert!(r.value == u256::max())
}

#[test]
fn sweep_finds_small_exact_answer() {
    let r = shrink(
        |w: u256| !(w == 0 || w >= 37),
        failing: 900000,
        lo: 1,
        budget: 10000,
    )
    assert!(r.value == 37)
}

#[test]
fn never_returns_a_passing_value() {
    let r = shrink(
        |w: u256| !(w == 4242),
        failing: 4242,
        lo: 0,
        budget: 10000,
    )
    assert!(r.value == 4242)
}

#[test]
fn power_of_two_steps_cross_parity() {
    // Regression: best = 2^38 - 1 with best / 2^j steps made every candidate
    // even, so an odd-only failure never shrank. Failing set: odd words >= 1999.
    let r = shrink(
        |w: u256| !(w % 2 == 1 && w >= 1999),
        failing: 0x3fffffffff,
        lo: 0,
        budget: 10000,
    )
    assert!(r.value == 1999 && r.complete)
}

#[test]
fn complete_result_is_a_verified_local_minimum() {
    let holds = |w: u256| !(w > 300 && (w % 3 == 0 || w % 5 == 0))
    let r = shrink(holds, failing: 999999, lo: 0, budget: 100000)
    assert!(r.complete)
    assert!(!holds(r.value))
    var k: u256 = 0
    while k < 256 {
        let step: u256 = 1 << k
        if step <= r.value {
            assert!(holds(r.value - step))
        }
        k += 1
    }
}
