# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo

# Environment. NEVER commit these. Commit .env.example instead.
.env
.env.local
.env*.local

# Contracts
cache/
broadcast/*/31337/

# Logs
*.log
npm-debug.log*

# Editor and OS
.DS_Store
Thumbs.db
.idea/
*.swp

# Markdown: only README.md and the .md files README.md links to are published.
# Everything else (CLAUDE.md, handoff.md, memory.md, idea.md, notes) stays local.
# When README.md links a new .md file, add a matching !path line below.
*.md
!README.md

# Fe debugging reports (fe build/test --report)
*.tar.gz

# Fuzzloom: generated harnesses are scratch; failure records are meant to be
# committed in user projects, except the example's, which every demo run
# regenerates.
**/.fuzzloom/tmp/
examples/*/.fuzzloom/failures/

# Spike scratch harnesses
.tmp/

# CI output (scripts/ci.sh)
reports/
